/* ==========================================================================
   Step 3 & 4: Flexbox Grid Container Architecture
   ========================================================================== */
.product-grid-wrapper {
    display: flex;              /* Activates the main Flexbox engine layout layout */
    flex-wrap: wrap;            /* Instructs elements to wrap smoothly to subsequent lines when space shrinks */
    gap: 24px;                  /* Establishes even spacing alleys between product rows/columns */
    max-width: 1200px;
    margin: 0 auto;
}

/* ==========================================================================
   Step 5: Experimenting with Flex Grow, Shrink, and Basis sizing
   ========================================================================== */
.product-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 16px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    
    /* Flex Mechanics Explored: 
       flex-grow: 1 (Fills out empty leftover space in rows evenly)
       flex-shrink: 1 (Compresses smoothly during viewport collapse)
       flex-basis: 280px (Ideal initial horizontal reference footprint size) */
    flex: 1 1 280px; 
    
    display: flex;
    flex-direction: column;    /* Internal card items fall vertically straight down */
}

/* Image Presentation Framing */
.product-image-frame {
    width: 100%;
    height: 200px;
    background-color: #f1f5f9;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 16px;
}

.product-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Product Info Elements */
.product-name {
    font-size: 1.2rem;
    color: #0f172a;
    margin-bottom: 8px;
}

.product-price {
    font-size: 1.4rem;
    font-weight: 700;
    color: #10b981;             /* Dynamic green for financial highlights */
    margin-bottom: 16px;
}

/* Operational Buy Button Elements */
.buy-btn {
    display: block;
    width: 100%;
    padding: 12px;
    text-align: center;
    background-color: #2563eb;  /* Solid primary button blue */
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    margin-top: auto;           /* Automatically floats button down if cards scale height unevenly */
    transition: background-color 0.2s ease;
}

.buy-btn:hover {
    background-color: #1d4ed8;
}
