/* ==========================================================================
   Global Reset & Page Layout
   ========================================================================== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background-color: #f1f5f9;
    color: #1e293b;
    height: 100vh;
