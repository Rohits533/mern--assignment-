    color: #64748b;
    font-size: 1.05rem;
}

/* ==========================================================================
   Step 3 & 5: Auto-Responsive CSS Grid Configuration
   ========================================================================== */
.photo-gallery-grid {
    display: grid;
    /* auto-fit: Automatically fragments rows into columns based on remaining canvas width.
       minmax(250px, 1fr): Cards will shrink or grow gracefully, but will never step below a 250px base width footprint constraint. */
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px; /* Precise uniform spacing lines splitting image items cleanly */
    max-width: 1200px;
    margin: 0 auto;
}

/* ==========================================================================
   Step 2 & 4: Gallery Item Component & Image Aspect Ratios
   ========================================================================== */
.gallery-card-unit {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.gallery-card-unit:hover {
    transform: translateY(-4px); /* Interactive lift animation */
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.image-frame {
    width: 100%;
    height: 220px; /* Fixed height metric boundary enforces row consistency */
    overflow: hidden;
    background-color: #cbd5e1;
}

.image-frame img {
    width: 100%; /* Spans full card frame boundaries */
    height: 100%;
    object-fit: cover; /* CRUCIAL: Crops and fits images neatly without squeezing or distorting shapes */
    display: block;
}

/* Optional Card Detail Area */
.image-metadata-box {
    padding: 14px 16px;
}

