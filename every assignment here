.accent-green { border-left: 4px solid #10b981; }
.accent-purple { border-left: 4px solid #8b5cf6; }
.accent-amber { border-left: 4px solid #f59e0b; }

/* ==========================================================================
   Responsive Adaptation for Small Screen Sizes
   ========================================================================== */
@media (max-width: 768px) {
    .dashboard-grid-container {
        /* Re-maps grid layout layout to stack components in a flat single vertical list */
        grid-template-columns: 1fr;
        grid-template-rows: 60px auto auto;
        grid-template-areas: 
            "header"
            "sidebar"
            "main";
        height: auto;
