/* ==========================================================================
   Pricing Cards Area (Horizontal Flex Flow Axis)
   ========================================================================== */
.pricing-section {
    max-width: 1100px;
    margin: 0 auto 60px auto;
}

.cards-container {
    display: flex;                  /* Activates Flexbox Engine Layout */
    flex-direction: row;            /* Lines card children up along the horizontal row axis */
    justify-content: center;        /* Centers cards horizontally with even distribution spacing */
    align-items: stretch;           /* Enforces uniform column stretching so all cards remain equal height */
    gap: 24px;
    flex-wrap: wrap;                /* Wraps elements to prevent overlapping breaks on smaller viewports */
}

/* Base Individual Card Layout Footprint */
.pricing-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 30px 24px;
    width: 100%;
    max-width: 320px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;         /* Nested Flexbox: Arranges card body text straight down sequentially */
}

.card-title { font-size: 1.25rem; color: #475569; margin-bottom: 12px; text-align: left; }
.card-price { font-size: 2rem; font-weight: 700; color: #0f172a; margin-bottom: 16px; }
.card-price span { font-size: 0.9rem; font-weight: 400; color: #64748b; }

.features-list {
    list-style: none;
    margin-bottom: 24px;
    flex-grow: 1;                   /* Explodes the mid-section lists to force action buttons straight flush to bottom */
}

.features-list li {
    font-size: 0.95rem;
    color: #475569;
    padding: 8px 0;
    border-bottom: 1px solid #f1f5f9;
}

/* Card Button Elements */
.card-btn {
    display: block;
    width: 100%;
    padding: 12px;
    text-align: center;
    background-color: #0f172a;
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.2s ease;
}

.card-btn:hover { background-color: #1e293b; }

/* Visual emphasis highlight helper rule targeting the Pro Tier option */
.pro-highlight {
    border: 2px solid #2563eb;
    position: relative;
}
.pro-highlight .card-btn { background-color: #2563eb; }
.pro-highlight .card-btn:hover { background-color: #1d4ed8; }

/* ==========================================================================
