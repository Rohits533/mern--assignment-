/* ==========================================================================
   Outer Grid Architecture Shell
   ========================================================================== */
.dashboard-grid-container {
    display: grid;
    /* Rows: 60px height for header, auto-fill remaining height for main panel workspace */
    grid-template-rows: 60px auto;
    /* Columns: 240px wide sidebar panel, auto-scaling for main panel content window */
    grid-template-columns: 240px auto;
    
    /* Grid Area Assignments Name Mapping */
    grid-template-areas: 
        "header header"
        "sidebar main";
    
    height: 100vh;
}

/* ==========================================================================
   Structural Grid Panels
   ========================================================================== */

/* 1. Dashboard Header Panel */
.dash-header {
    grid-area: header;
    background-color: #0f172a; /* Deep Slate Navy */
