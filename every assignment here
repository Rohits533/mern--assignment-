    --space-medium: 16px;
    --space-large: 32px;

    /* Typography Scale Tokens */
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-md: 1.25rem;
    --font-size-lg: 2rem;
}

/* ==========================================================================
   2. Global Application Using Tokens
   ========================================================================== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
