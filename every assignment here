   ========================================================================== */
.of-visible {
    overflow: visible;    /* Text breaks past boundary lines and spills out */
    border-color: #ef4444; /* Red indicator border */
}

.of-hidden {
    overflow: hidden;     /* Spilled text is cleanly sliced away and invisible */
    border-color: #f59e0b; /* Amber indicator border */
}

.of-scroll {
    overflow: scroll;     /* Forces scrollbar tracks on permanently, layout text or not */
    border-color: #3b82f6; /* Blue indicator border */
}

.of-auto {
    overflow: auto;       /* Spawns scrollbars dynamically only when text exceeds container */
    border-color: #10b981; /* Green indicator border */
}

/* ==========================================================================
