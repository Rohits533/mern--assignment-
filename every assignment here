1. The Design-Token Stylesheet (tokens.css)

css
/* ==========================================================================
   1. Design Token Declarations (:root)
   ========================================================================== */
:root {
    /* Color Tokens */
    --color-primary: #3b82f6;      /* Vibrant Blue */
    --color-secondary: #10b981;    /* Emerald Green */
    --color-bg: #f8fafc;           /* Cool Light Gray */
    --color-card-bg: #ffffff;      /* Pure White for layout blocks */
    --color-text: #1e293b;         /* Deep Charcoal slate */
    --color-muted: #64748b;        /* Cool Gray text variant */

    /* Spacing & Layout Tokens */
    --space-small: 8px;
    --space-medium: 16px;
    --space-large: 32px;

    /* Typography Scale Tokens */
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-md: 1.25rem;
    --font-size-lg: 2rem;
}

/* ==========================================================================
   2. Global Application Using Tokens
   ========================================================================== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: var(--font-size-base);
    line-height: 1.5;
    padding: var(--space-large);
}

main {
    max-width: 600px;
    margin: 0 auto;
}

h1 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-medium);
}

h2 {
    font-size: var(--font-size-md);
    margin-bottom: var(--space-small);
}

p {
    margin-bottom: var(--space-medium);
}

/* ==========================================================================
   3. Reusable Component Styling (Cards & Buttons)
   ========================================================================== */
.card {
    background-color: var(--color-card-bg);
    border: 1px solid #e2e8f0;
    border-radius: var(--space-small);
    padding: var(--space-large);
    margin-bottom: var(--space-medium);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.card p {
    color: var(--color-muted);
    font-size: var(--font-size-sm);
}

/* Reusable Button Group Elements */
.btn {
    display: inline-block;
    border: none;
    border-radius: var(--space-small);
    padding: var(--space-medium) var(--space-large);
    font-size: var(--font-size-base);
    font-weight: 600;
    cursor: pointer;
    margin-right: var(--space-small);
    transition: opacity 0.2s ease-in-out;
}

.btn:hover {
    opacity: 0.9;
}

/* Contextual Button Accents using Core System Tokens */
.btn-primary {
    background-color: var(--color-primary);
    color: #ffffff;
}

.btn-secondary {
    background-color: var(--color-secondary);
    color: #ffffff;
}
