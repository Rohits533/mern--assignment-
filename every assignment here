   ========================================================================== */
nav {
    position: -webkit-sticky; /* Support for older webkit builds */
    position: sticky;
    top: 0;
    background-color: #2563eb;
    padding: 15px 20px;
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    /* High z-index keeps the navbar sitting safely above standard content cards */
    z-index: 100; 
}

nav a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    margin: 0 15px;
}

/* Long vertical placeholder layout blocks to enforce deep scrolling */
.scroll-section {
    min-height: 80vh; 
    padding: 60px 20px;
    max-width: 800px;
    margin: 0 auto;
}

/* ==========================================================================
   Steps 4 & 5: Relative Parent & Absolute Child Card Positioning
   ========================================================================== */
.card-wrapper {
    position: relative; /* CRUCIAL: Establishes a boundary coordinate frame for children */
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 30px 20px;
    margin-top: 30px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.absolute-badge {
    position: absolute; /* Latches directly to closest ancestor marked relative */
    top: 12px;
    right: 12px;
    background-color: #10b981; /* Green color banner */
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ==========================================================================
   Step 3: Fixed Floating Action Button (FAB)
   Stays completely pinned to the screen viewport regardless of page scrolling.
   ========================================================================== */
.floating-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background-color: #ef4444; /* Bright red color accent for high visibility */
    color: #ffffff;
    border: none;
    border-radius: 50px;
    padding: 16px 24px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3);
    /* Max layout depth z-index keeps button floating above nav blocks during scroll overlaps */
    z-index: 999; 
    transition: transform 0.2s ease;
}

.floating-fab:hover {
    transform: scale(1.05);
}
