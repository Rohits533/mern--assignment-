<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment 4.2 — Job Application Form</title>
</head>
<body>

    <header>
        <h1>Job Application Form</h1>
    </header>

    <main>
        <form action="#" method="POST">

            <!-- Full Name -->
            <div>
                <label for="applicant-name">Full Name:</label>
                <input type="text" id="applicant-name" name="applicant_name" required>
            </div>
            <br>

            <!-- Email -->
            <div>
                <label for="applicant-email">Email Address:</label>
                <input type="email" id="applicant-email" name="applicant_email" required>
            </div>
            <br>

            <!-- Phone -->
            <div>
                <label for="applicant-phone">Phone Number:</label>
                <input type="tel" id="applicant-phone" name="applicant_phone" required>
            </div>
            <br>

            <!-- Date of Birth -->
            <div>
                <label for="applicant-dob">Date of Birth:</label>
                <input type="date" id="applicant-dob" name="applicant_dob" required>
            </div>
            <br>

            <!-- Portfolio URL -->
            <div>
                <label for="applicant-portfolio">Portfolio URL:</label>
                <input type="url" id="applicant-portfolio" name="applicant_portfolio" required>
            </div>
            <br>

            <!-- Radio Buttons (Preferred Shift Group - shares the same 'name' attribute) -->
            <fieldset>
                <legend>Preferred Shift:</legend>
                
                <input type="radio" id="shift-day" name="preferred_shift" value="day" checked>
                <label for="shift-day">Day Shift</label>
                
                <input type="radio" id="shift-night" name="preferred_shift" value="night">
                <label for="shift-night">Night Shift</label>
            </fieldset>
            <br>

            <!-- Checkboxes (Skills) -->
            <fieldset>
                <legend>Technical Skills:</legend>
                
                <input type="checkbox" id="skill-html" name="skills" value="html">
                <label for="skill-html">HTML5</label>
                
                <input type="checkbox" id="skill-css" name="skills" value="css">
                <label for="skill-css">CSS3</label>
                
                <input type="checkbox" id="skill-js" name="skills" value="javascript">
                <label for="skill-js">JavaScript</label>
            </fieldset>
            <br>

            <!-- Dropdown Menu (Job Role) -->
            <div>
                <label for="job-role">Applied Job Role:</label>
                <select id="job-role" name="job_role" required>
                    <option value="">-- Please Select a Role --</option>
                    <option value="frontend">Front-End Developer</option>
                    <option value="backend">Back-End Developer</option>
                    <option value="designer">UI/UX Designer</option>
                </select>
            </div>
            <br>

            <!-- Textarea (Cover Letter) -->
            <div>
                <label for="cover-letter">Cover Letter:</label><br>
                <textarea id="cover-letter" name="cover_letter" rows="6" cols="50" required></textarea>
            </div>
            <br>

            <!-- Disabled Field Example -->
            <div>
                <label for="application-status">Application Status:</label>
                <input type="text" id="application-status" name="status" value="Pending Review" disabled>
            </div>
            <br>

            <!-- Submit Button -->
            <div>
                <button type="submit">Submit Application</button>
            </div>

        </form>
    </main>

</body>
</html>










