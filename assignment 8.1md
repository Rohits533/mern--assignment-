<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment 8.1 — Dashboard-Style Grid Layout</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Main Outer Dashboard Grid Container -->
    <div class="dashboard-container">
        
        <!-- 1. Dashboard Header -->
        <header class="db-header">
            <div class="brand">Grid<span>Dash</span></div>
            <div class="user-profile">Admin Session</div>
        </header>

        <!-- 2. Sidebar Component -->
        <aside class="db-sidebar">
            <ul class="sidebar-menu">
                <li><a href="#" class="active">Overview</a></li>
                <li><a href="#">Analytics</a></li>
                <li><a href="#">Management</a></li>
                <li><a href="#">System Logs</a></li>
            </ul>
        </aside>

        <!-- 2. Main Content Area -->
        <main class="db-main">
            
            <div class="main-header">
                <h2>System Overview</h2>
                <p>Real-time analytics engine grid infrastructure metrics.</p>
            </div>

            <!-- 3. Statistic Cards Grid Subheading Container -->
            <div class="stats-grid">
                
                <!-- Stat Card 1 -->
                <div class="stat-card">
                    <div class="card-label">Total Requests</div>
                    <div class="card-value">1,482,910</div>
                    <div class="card-trend upward">+12.4% this week</div>
                </div>

                <!-- Stat Card 2 -->
                <div class="stat-card">
                    <div class="card-label">CPU Core Load</div>
                    <div class="card-value">34.2%</div>
                    <div class="card-trend steady">Optimal operations</div>
                </div>

                <!-- Stat Card 3 -->
                <div class="stat-card">
                    <div class="card-label">Memory Node Pool</div>
                    <div class="card-value">8.4 / 16 GB</div>
                    <div class="card-trend downward">-2.1% drop</div>
                </div>

                <!-- Stat Card 4 -->
                <div class="stat-card">
                    <div class="card-label">Active Web Hooks</div>
                    <div class="card-value">422</div>
                    <div class="card-trend upward">+5 new channels</div>
                </div>

            </div>

            <!-- Secondary Content Display Block Example -->
            <div class="data-display-panel">
                <h3>Grid Framework Inspection Console</h3>
                <p>Open Chrome DevTools, click the <strong>Elements</strong> tab, and click the little <code>grid</code> badge overlay beside the <code>.dashboard-container</code> element to view your columns and rows drawn dynamically onto the viewport.</p>
            </div>

        </main>

    </div>

</body>
</html>












/* ==========================================
   RESET & SYSTEM CONSTANTS
   ========================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #f1f5f9;
    color: #1e293b;
    line-height: 1.5;
    height: 100vh;
    overflow: hidden; /* Keeps dashboard container locked to viewport constraints */
}

/* ==========================================
   4. OUTER DISPLAY GRID LAYOUT DESIGN
   ========================================== */
.dashboard-container {
    display: grid;
    
    /* 5. Set custom template configurations 
       Columns: Sidebar takes 240px static width, Main Content claims remaining space fluidly.
       Rows: Header takes 70px static height, Content area claims remaining viewport space. */
    grid-template-columns: 240px 1fr;
    grid-template-rows: 70px 1fr;
    
    width: 100vw;
    height: 100vh;
}

/* ==========================================
   GRID COMPONENT PLACEMENT ASSIGNMENTS
   ========================================== */

/* Header Area Block spanning both columns */
.db-header {
    grid-column: 1 / span 2;
    background-color: #0f172a;
    color: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 24px;
    border-bottom: 1px solid #1e293b;
}

.brand {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.5px;
}
.brand span { color: #3b82f6; }

.user-profile {
    font-size: 0.85rem;
    background-color: #1e293b;
    padding: 6px 14px;
    border-radius: 20px;
    color: #cbd5e1;
}

/* Sidebar Area Block positioned underneath header */
.db-sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
    padding: 24px var(--spacing, 16px);
}

.sidebar-menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.sidebar-menu a {
    display: block;
    text-decoration: none;
    color: #475569;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 10px 14px;
    border-radius: 6px;
    transition: all 0.2s ease;
}

.sidebar-menu a:hover,
.sidebar-menu a.active {
    background-color: #eff6ff;
    color: #3b82f6;
}

/* Main Dashboard Canvas Area Block */
.db-main {
    padding: 30px;
    overflow-y: auto; /* Enables independent scrolling within main panel if card volume grows */
}

.main-header {
    margin-bottom: 24px;
}

.main-header h2 {
    font-size: 1.5rem;
    color: #0f172a;
}

.main-header p {
    color: #64748b;
    font-size: 0.95rem;
}

/* ==========================================
   NESTED STATISTIC CARDS GRID GRID (Step 3)
   ========================================== */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    
    /* 6. Use explicit gaps between cards */
    gap: 20px;
    
    margin-bottom: 30px;
}

.stat-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
}

.card-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.card-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin: 8px 0;
}

.card-trend {
    font-size: 0.8rem;
    font-weight: 500;
}

.upward { color: #16a34a; }
.downward { color: #dc2626; }
.steady { color: #475569; }

/* ==========================================
   SECONDARY METRICS CONTAINER
   ========================================== */
.data-display-panel {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 24px;
}

.data-display-panel h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
}

.data-display-panel p {
    font-size: 0.9rem;
    color: #475569;
}

/* ==========================================
   RESPONSIVE OVERRIDE STYLING METRICS
   ========================================== */
@media (max-width: 768px) {
    /* Shifts global multi-column grid dashboard layout into a single vertical stream */
    .dashboard-container {
        grid-template-columns: 1fr;
        grid-template-rows: 70px auto 1fr;
        height: auto;
        overflow: visible;
    }
    
    .db-header {
        grid-column: 1;
    }
    
    body {
        overflow: auto;
        height: auto;
    }
}
