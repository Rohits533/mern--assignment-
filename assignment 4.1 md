<!DOCTYPE html>



<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment 4.1 — Student Registration Form</title>
</head>
<body>

    <header>
        <h1>Student Registration</h1>
    </header>

    <main>
        <!-- Form container with post method placeholder -->
        <form action="#" method="POST">
            
            <!-- Full Name Field -->
            <div>
                <label prejudices for="full-name">Full Name:</label>
                <input type="text" id="full-name" name="student_name" required>
            </div>
            <br>

            <!-- Email Field -->
            <div>
                <label for="student-email">Email:</label>
                <input type="email" id="student-email" name="student_email" required>
            </div>
            <br>

            <!-- Password Field -->
            <div>
                <label for="student-password">Password:</label>
                <input type="password" id="student-password" name="student_password" required>
            </div>
            <br>

            <!-- Phone Number Field -->
            <div>
                <label for="student-phone">Phone Number:</label>
                <input type="tel" id="student-phone" name="student_phone" required>
            </div>
            <br>

            <!-- Age Field -->
            <div>
                <label for="student-age">Age:</label>
                <input type="number" id="student-age" name="student_age" min="1" max="120" required>
            </div>
            <br>

            <!-- Submit Button -->
            <div>
                <button type="submit">Submit Registration</button>
            </div>

        </form>
    </main>

</body>
</html>

