<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment 6.5 — Profile & Product Card Mini-Project</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="page-header">
        <h1>Component Showcase Layout</h1>
        <p>Responsive profile and product card implementations leveraging advanced CSS positioning and box model styling rules.</p>
    </header>

    <main class="showcase-container">
        
        <!-- COMPONENT 1: PROFILE CARD -->
        <article class="profile-card">
            <!-- Positioned Active Status Badge -->
            <span class="status-badge">Available</span>
            
            <div class="profile-header">
                <!-- SVG Avatar Placeholder to ensure image asset displays without external broken links -->
                <svg class="profile-img" viewBox="0 0 100 100" xmlns="http://w3.org">
                    <circle cx="50" cy="50" r="50" fill="#e2e8f0"/>
                    <circle cx="50" cy="40" r="20" fill="#94a3b8"/>
                    <path d="M20 80.5C20 65.5 30 55 50 55s30 10.5 30 25.5v4.5H20v-4.5z" fill="#94a3b8"/>
                </svg>
                <h2 class="profile-name">Alex Morgan</h2>
                <p class="profile-role">Lead UI/UX Engineer</p>
            </div>

            <p class="profile-desc">
                Specialized in architecting high-performance, accessible design tokens and scalable CSS layout systems for cloud platforms.
            </p>

            <div class="skills-container">
                <span class="skill-tag">CSS Grid</span>
                <span class="skill-tag">Figma</span>
                <span class="skill-tag">Vanilla JS</span>
                <span class="skill-tag">A11y</span>
            </div>

            <a href="mailto:alex@example.com" class="btn btn-profile">Contact Professional</a>
        </article>

        <!-- COMPONENT 2: PRODUCT CARD -->
        <article class="product-card">
            <!-- Positioned Sales Promo Badge -->
            <span class="promo-badge">20% OFF</span>
            
            <!-- SVG Product Illustration Placeholder -->
            <div class="product-img-wrapper">
                <svg class="product-img" viewBox="0 0 200 150" xmlns="http://w3.org">
                    <rect width="200" height="150" fill="#eff6ff" rx="8"/>
                    <rect x="50" y="35" width="100" height="80" rx="6" fill="#3b82f6" opacity="0.8"/>
                    <circle cx="150" cy="35" r="15" fill="#f59e0b"/>
                </svg>
            </div>

            <div class="product-info">
                <div class="product-meta">
                    <h2 class="product-name">Quantum ANC Headphones</h2>
                    <div class="product-price">$199.00</div>
                </div>
                
                <p class="product-desc">
                    Experience studio-grade active noise cancellation paired with custom spatial audio drivers and an ergonomic 40-hour battery life blueprint.
                </p>

                <button class="btn btn-product">Buy Now</button>
            </div>
        </article>

    </main>

</body>
</html>











/* ==========================================
   GLOBAL RESET & STRUCTURE
   ========================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: #f1f5f9;
    color: #1e293b;
    line-height: 1.5;
    padding: 40px 20px;
}

.page-header {
    text-align: center;
    margin-bottom: 50px;
}

.page-header h1 {
    font-size: 2.25rem;
    color: #0f172a;
    margin-bottom: 8px;
}

.page-header p {
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
}

/* Responsive Grid Canvas Container */
.showcase-container {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 40px;
    justify-items: center;
    align-items: start;
}

/* ==========================================
   SHARED UI BUTTON COMPONENT
   ========================================== */
.btn {
    display: block;
    width: 100%;
    padding: 12px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

.btn:active {
    transform: scale(0.98);
}

/* ==========================================
   PROFILE CARD LAYOUT
   ========================================== */
.profile-card {
    position: relative; /* Anchor for absolute status badge */
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 32px;
    width: 100%;
    max-width: 380px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
}

/* Absolute Status Badge */
.status-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: #dcfce7;
    color: #15803d;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid #bbf7d0;
}

.profile-header {
    text-align: center;
    margin-bottom: 20px;
}

.profile-img {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    margin-bottom: 16px;
    border: 3px solid #f1f5f9;
}

.profile-name {
    font-size: 1.35rem;
    color: #0f172a;
    font-weight: 700;
}

.profile-role {
    font-size: 0.9rem;
    color: #4f46e5;
    font-weight: 600;
    margin-top: 2px;
}

.profile-desc {
    font-size: 0.9rem;
    color: #475569;
    text-align: center;
    margin-bottom: 24px;
}

/* Skill Tags Cloud Matrix */
.skills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 28px;
}

.skill-tag {
    background-color: #f8fafc;
    color: #475569;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
}

.btn-profile {
    background-color: #0f172a;
    color: #ffffff;
}

.btn-profile:hover {
    background-color: #1e293b;
}

/* ==========================================
   PRODUCT CARD LAYOUT
   ========================================== */
.product-card {
    position: relative; /* Anchor for absolute promo badge */
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    width: 100%;
    max-width: 380px;
    overflow: hidden; /* Ensures image corners obey parent border-radius */
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
}

/* Absolute Promo Badge */
.promo-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: #ef4444;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    z-index: 10;
}

.product-img-wrapper {
    width: 100%;
    padding: 16px;
    background-color: #f8fafc;
}

.product-img {
    width: 100%;
    height: auto;
    display: block;
}

.product-info {
    padding: 24px;
}

.product-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
}

.product-name {
    font-size: 1.25rem;
    color: #0f172a;
    font-weight: 700;
}

.product-price {
    font-size: 1.25rem;
    color: #10b981;
    font-weight: 700;
    white-space: nowrap;
}

.product-desc {
    font-size: 0.9rem;
    color: #475569;
    margin-bottom: 24px;
}

.btn-product {
    background-color: #3b82f6;
    color: #ffffff;
}

.btn-product:hover {
    background-color: #2563eb;
}
