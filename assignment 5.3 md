<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment 5.3 — Typography Showcase Page</title>
    <!-- Google Fonts: Lora (Serif) for headings & Inter (Sans-Serif) for body text -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Inter:wght@300;400;600&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="main-header">
        <h1>Typography Showcase</h1>
        <p class="subtitle">Exploring Hierarchy, Pairing, and CSS Text Properties</p>
    </header>

    <main class="container">
        
        <!-- Section 1: Heading Styles -->
        <section class="showcase-section">
            <h2 class="section-title">Heading Styles</h2>
            <div class="card">
                <h1>Heading 1: Lora Bold 2.5rem</h1>
                <h2>Heading 2: Lora Bold 2.0rem</h2>
                <h3>Heading 3: Lora SemiBold 1.5rem</h3>
            </div>
        </section>

        <!-- Section 2: Paragraph Styles -->
        <section class="showcase-section">
            <h2 class="section-title">Paragraph Styles</h2>
            <div class="card">
                <p class="para-lead">Lead Paragraph: Inter Light, 1.2rem size, with expanded line-height and letter-spacing for premium readability at the beginning of article layouts.</p>
                <p class="para-standard">Standard Body Paragraph: Inter Regular, 1rem size. This block demonstrates optimized readability metrics. Notice how the tracking and line heights contrast cleanly with the headings above to create a natural, comfortable scanning rhythm for long-form user reading experiences.</p>
            </div>
        </section>

        <!-- Section 3: Text Emphasis -->
        <section class="showcase-section">
            <h2 class="section-title">Text Emphasis</h2>
            <div class="card emphasis-container">
                <p class="text-left">This text is aligned to the <strong>left</strong>.</p>
                <p class="text-center">This text is aligned to the <strong>center</strong>.</p>
                <p class="text-right">This text is aligned to the <strong>right</strong>.</p>
                <hr>
                <p class="text-decorated">This paragraph features an underline decoration.</p>
                <p class="text-italic">This paragraph showcases the elegant italic variant of the Lora font family.</p>
            </div>
        </section>

    </main>

    <footer class="main-footer">
        <p>Assignment 5.3 — Web Typography Showcase</p>
    </footer>

</body>
</html>









