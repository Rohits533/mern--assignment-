/* Base Reset and Variables */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    /* Font Family Selection: Inter for Body Text */
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: #2d3748;
    background-color: #f7fafc;
    padding-bottom: 40px;
}

.container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header & Footer Styling */
.main-header {
    text-align: center;
    padding: 60px 20px;
    background-color: #fff;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 40px;
}

.main-header h1 {
    font-family: 'Lora', serif;
    font-size: 3rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 10px;
}

.subtitle {
    font-size: 1.1rem;
    font-weight: 300;
    color: #718096;
    letter-spacing: 0.5px;
}

.main-footer {
    text-align: center;
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid #e2e8f0;
    color: #a0aec0;
    font-size: 0.875rem;
}

/* Section Layout */
.showcase-section {
    margin-bottom: 40px;
}

.section-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #4a5568;
    margin-bottom: 15px;
    border-left: 4px solid #4299e1;
    padding-left: 10px;
}

.card {
    background-color: #fff;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
}

/* Section 1: Heading Elements (Lora Font Family) */
h1, h2, h3 {
    font-family: 'Lora', serif;
    color: #1a202c;
    font-weight: 700;
    margin-bottom: 15px;
}

h1 { font-size: 2.5rem; }
h2 { font-size: 2.0rem; }
h3 { font-size: 1.5rem; font-weight: 400; }

/* Section 2: Paragraph Layout Elements */
.para-lead {
    font-size: 1.2rem;
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    color: #4a5568;
}

.para-standard {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0px;
    color: #2d3748;
}

/* Section 3: Text Emphasis Properties */
.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

.emphasis-container p {
    margin-bottom: 12px;
}

hr {
    border: 0;
    height: 1px;
    background: #e2e8f0;
    margin: 20px 0;
}

.text-decorated {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: #2b6cb0;
}

.text-italic {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 1.1rem;
}
