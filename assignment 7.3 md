<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment 7.3 — Responsive Product Listing</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="catalog-header">
        <h1>Flexbox Storefront Catalog</h1>
        <p>A fluid, wrap-ready responsive product catalog demonstrating <code>flex-grow</code>, <code>flex-shrink</code>, and <code>flex-basis</code> configurations.</p>
    </header>

    <!-- Step 3: Main Flexbox Container Shell -->
    <main class="product-grid-container">
        
        <!-- Product Card 1 -->
        <article class="product-item-card">
            <div class="product-image-frame img-bg-blue">
                <svg viewBox="0 0 100 100" class="placeholder-svg"><circle cx="50" cy="50" r="30" fill="#3b82f6" opacity="0.6"/></svg>
            </div>
            <div class="product-details">
                <h3 class="product-name">Chronos Smartwatch v4</h3>
                <div class="product-price">$249.00</div>
                <button class="btn btn-cart">Add to Cart</button>
            </div>
        </article>

        <!-- Product Card 2 -->
        <article class="product-item-card">
            <div class="product-image-frame img-bg-purple">
                <svg viewBox="0 0 100 100" class="placeholder-svg"><rect x="20" y="20" width="60" height="60" rx="10" fill="#8b5cf6" opacity="0.6"/></svg>
            </div>
            <div class="product-details">
                <h3 class="product-name">AeroStream Pods Pro</h3>
                <div class="product-price">$179.00</div>
                <button class="btn btn-cart">Add to Cart</button>
            </div>
        </article>

        <!-- Product Card 3 -->
        <article class="product-item-card">
            <div class="product-image-frame img-bg-amber">
                <svg viewBox="0 0 100 100" class="placeholder-svg"><polygon points="50,15 90,85 10,85" fill="#f59e0b" opacity="0.6"/></svg>
            </div>
            <div class="product-details">
                <h3 class="product-name">Lumina Desktop Ambient Bar</h3>
                <div class="product-price">$89.00</div>
                <button class="btn btn-cart">Add to Cart</button>
            </div>
        </article>

        <!-- Product Card 4 -->
        <article class="product-item-card">
            <div class="product-image-frame img-bg-emerald">
                <svg viewBox="0 0 100 100" class="placeholder-svg"><circle cx="50" cy="50" r="35" fill="#10b981" opacity="0.6"/></svg>
            </div>
            <div class="product-details">
                <h3 class="product-name">Apex Ergonomic Trackpad</h3>
                <div class="product-price">$129.00</div>
                <button class="btn btn-cart">Add to Cart</button>
            </div>
        </article>

        <!-- Product Card 5 -->
        <article class="product-item-card">
            <div class="product-image-frame img-bg-rose">
                <svg viewBox="0 0 100 100" class="placeholder-svg"><rect x="25" y="25" width="50" height="50" transform="rotate(45 50 50)" fill="#f43f5e" opacity="0.6"/></svg>
            </div>
            <div class="product-details">
                <h3 class="product-name">Titanium Keycap Matrix</h3>
                <div class="product-price">$65.00</div>
                <button class="btn btn-cart">Add to Cart</button>
            </div>
        </article>

        <!-- Product Card 6 -->
        <article class="product-item-card">
            <div class="product-image-frame img-bg-cyan">
                <svg viewBox="0 0 100 100" class="placeholder-svg"><path d="M50 15 L85 50 L50 85 L15 50 Z" fill="#06b6d4" opacity="0.6"/></svg>
            </div>
            <div class="product-details">
                <h3 class="product-name">MagSafe Power Vault</h3>
                <div class="product-price">$99.00</div>
                <button class="btn btn-cart">Add to Cart</button>
            </div>
        </article>

    </main>

</body>
</html>








/* ==========================================
   RESET & SYSTEM CONFIGURATION
   ========================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #f8fafc;
    color: #1e293b;
    padding: 40px 20px;
    line-height: 1.5;
}

.catalog-header {
    text-align: center;
    margin-bottom: 40px;
}

.catalog-header h1 {
    font-size: 2.25rem;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
}

.catalog-header p {
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
}

/* ==========================================
   FLEXBOX PARENT GRID CONTAINER CONFIGURATION
   ========================================== */
.product-grid-container {
    /* Step 3: Activating Flexbox Layout Mode */
    display: flex;
    
    /* Step 3 & 6: Standardizes wrap workflow for small viewports */
    flex-wrap: wrap;
    
    /* Step 4: Spacing between wrapping grid items */
    gap: 24px;
    
    max-width: 1200px;
    margin: 0 auto;
}

/* ==========================================
   FLEX COMPONENT SHORTHAND MATRIX
   ========================================== */
.product-item-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);

    /* Step 5: Master alignment sizing rule configuration 
       flex-grow: 1  -> Card expands dynamically to absorb trailing whitespace.
       flex-shrink: 1 -> Card scales down safely to prevent viewport break overflows.
       flex-basis: 280px -> Establishes default base target rendering width. */
    flex: 1 1 280px;

    /* Internal layout styling for the cards */
    display: flex;
    flex-direction: column;
}

/* ==========================================
   INTERIOR CARD STYLING ELEMENTS
   ========================================== */
.product-image-frame {
    width: 100%;
    height: 200px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.placeholder-svg {
    width: 80px;
    height: 80px;
}

/* Asset Fallback Tints */
.img-bg-blue { background-color: #eff6ff; }
.img-bg-purple { background-color: #faf5ff; }
.img-bg-amber { background-color: #fffbeb; }
.img-bg-emerald { background-color: #f0fdf4; }
.img-bg-rose { background-color: #fff1f2; }
.img-bg-cyan { background-color: #ecfeff; }

.product-details {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
}

.product-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 8px;
}

.product-price {
    font-size: 1.2rem;
    font-weight: 600;
    color: #2563eb;
    margin-bottom: 16px;
}

.btn-cart {
    width: 100%;
    background-color: #0f172a;
    color: #ffffff;
    border: none;
    padding: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s;
}

.btn-cart:hover {
    background-color: #1e293b;
}
