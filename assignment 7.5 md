    </header>

    <!-- 2. Hero Section Component -->
    <section id="hero" class="hero-wrapper">
        <div class="inner-container hero-flex">
            <div class="hero-content">
                <h1 class="main-heading">Develop Smarter Layouts Instantly</h1>
                <p class="body-paragraph text-muted">
                    Engineered using responsive constraints, clean flow architectures, and semantic layout properties. Stop fighting text wrapping behaviors and design with precision framework nodes.
                </p>
                <div class="action-buttons">
                    <a href="#cta" class="btn btn-primary">Deploy Platform</a>
