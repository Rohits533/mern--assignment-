            <div class="hero-graphic">
                <svg class="graphic-svg" viewBox="0 0 400 300" xmlns="http://w3.org">
                    <rect width="400" height="300" rx="12" fill="#e2e8f0" opacity="0.3"/>
                    <rect x="40" y="50" width="320" height="40" rx="6" fill="#4f46e5" opacity="0.8"/>
                    <rect x="40" y="110" width="140" height="140" rx="8" fill="#0ea5e9" opacity="0.7"/>
