            </div>
            
            <div class="cards-flex-row">
                <!-- Feature Card 1 -->
                <article class="feature-card">
                    <div class="card-icon-frame c-blue">✦</div>
                    <h3 class="card-title">Fluid Geometry</h3>
                    <p class="card-desc text-muted">Adapts fluidly across display bounds using responsive sizing and structural alignment hooks.</p>
                </article>

                <!-- Feature Card 2 -->
                <article class="feature-card">
                    <div class="card-icon-frame c-green">▲</div>
                    <h3 class="card-title">Isolated Contexts</h3>
                    <p class="card-desc text-muted">Keeps nested block elements aligned cleanly without parent overflow failures.</p>
                </article>

                <!-- Feature Card 3 -->
                <article class="feature-card">
                    <div class="card-icon-frame c-purple">◼</div>
                    <h3 class="card-title">Atomic Tokens</h3>
                    <p class="card-desc text-muted">Built entirely using a consistent design system of typography sizes and space patterns.</p>
                </article>
